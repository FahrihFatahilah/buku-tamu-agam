APP_NAME=Dammm invitation
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ngundang.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

NGUNDANG_PLATFORM_DOMAIN=ngundang.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database — MySQL recommended for production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ngundang
DB_USERNAME=ngundang
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public
# For S3-compatible object storage (recommended for production):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_URL=

# Queue — use database for shared hosting, redis for production
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

# Redis (optional — not required for shared hosting)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Cloudflare (optional — only needed for custom domain SSL/cache purge)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ngundang.com
MAIL_FROM_NAME="Ngundang"
